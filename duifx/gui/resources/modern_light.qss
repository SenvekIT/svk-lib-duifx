/* Modern Light Theme QSS */

/* ============================================
   Custom Layout Widgets
   ============================================ */

#header {
    background-color: #e5e7eb;
    border-bottom: 1px solid #d1d5db;
}

#sidebar {
    background-color: #ffffff;
    border-right: 1px solid #e9ecef;
}

#rightSidebar {
    background-color: #ffffff;
    border-right: 1px solid #e9ecef;
}

#footer {
    background-color: #f8f9fa;
    border-top: 1px solid #e9ecef;
}

/* ============================================
   Global Application Styles
   ============================================ */

* {
    background-color: #f8f9fa;
    color: #212529;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 9pt;
}

/* ============================================
   Main Windows & Dialogs
   ============================================ */

QMainWindow {
    background-color: #ffffff;
    border: 1px solid #e9ecef;
}

QDialog {
    background-color: #ffffff;
    border: 1px solid #e9ecef;
    border-radius: 8px;
}

QMessageBox {
    background-color: #ffffff;
}

QMessageBox QPushButton {
    min-width: 80px;
    padding: 6px 16px;
}

/* ============================================
   Labels
   ============================================ */

QLabel {
    color: #495057;
    background-color: transparent;
    padding: 2px;
}

QLabel[class="title"] {
    font-size: 14pt;
    font-weight: bold;
    color: #343a40;
    padding: 4px 0px;
}

QLabel[class="subtitle"] {
    font-size: 11pt;
    color: #6c757d;
    font-weight: bold;
}

QLabel[class="highlight"] {
    color: #007bff;
    font-weight: bold;
}

/* ============================================
   Push Buttons
   ============================================ */

QPushButton {
    background-color: #ffffff;
    border: 1px solid #ced4da;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
    color: #495057;
    min-width: 32px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #f8f9fa;
    border-color: #adb5bd;
}

QPushButton:pressed {
    background-color: #e9ecef;
    border-color: #6c757d;
}

QPushButton:disabled {
    background-color: #f8f9fa;
    color: #adb5bd;
    border-color: #e9ecef;
}

/* Primary Button */
QPushButton[class="primary"] {
    background-color: #007bff;
    border-color: #007bff;
    color: white;
}

QPushButton[class="primary"]:hover {
    background-color: #0056b3;
    border-color: #004085;
}

QPushButton[class="primary"]:pressed {
    background-color: #004085;
    border-color: #002752;
}

QPushButton[class="primary"]:disabled {
    background-color: #6caedd;
    border-color: #6caedd;
    color: #ffffff;
}

/* Success Button */
QPushButton[class="success"] {
    background-color: #28a745;
    border-color: #28a745;
    color: white;
}

QPushButton[class="success"]:hover {
    background-color: #1e7e34;
    border-color: #1c7430;
}

QPushButton[class="success"]:pressed {
    background-color: #1c7430;
    border-color: #155724;
}

QPushButton[class="success"]:disabled {
    background-color: #82c991;
    border-color: #82c991;
    color: #ffffff;
}

/* Danger Button */
QPushButton[class="danger"] {
    background-color: #dc3545;
    border-color: #dc3545;
    color: white;
}

QPushButton[class="danger"]:hover {
    background-color: #c82333;
    border-color: #bd2130;
}

QPushButton[class="danger"]:pressed {
    background-color: #bd2130;
    border-color: #a71d2a;
}

QPushButton[class="danger"]:disabled {
    background-color: #e88e96;
    border-color: #e88e96;
    color: #ffffff;
}

/* ============================================
   Spin Boxes
   ============================================ */

QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 6px 8px;
    min-height: 20px;
    color: #495057;
    selection-background-color: #007bff;
    selection-color: white;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    background-color: #f8f9fa;
    border-color: #adb5bd;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #007bff;
    background-color: #ffffff;
}

QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #f8f9fa;
    color: #adb5bd;
    border-color: #e9ecef;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    width: 32px;
    border-width: 1px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    width: 32px;
    border-width: 1px;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(:/icons/icon/arrow-up-icon.svg);
    width: 12px;
    height: 12px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(:/icons/icon/arrow-down-icon.svg);
    width: 12px;
    height: 12px;
}

/* ============================================
   Line Edit
   ============================================ */

QLineEdit {
    background-color: #ffffff;
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 6px 12px;
    color: #495057;
    selection-background-color: #007bff;
    selection-color: white;
    min-height: 20px;
}

QLineEdit:hover {
    border-color: #adb5bd;
}

QLineEdit:focus {
    border-color: #007bff;
    background-color: #ffffff;
}

QLineEdit:disabled {
    background-color: #f8f9fa;
    color: #adb5bd;
    border-color: #e9ecef;
}

/* ============================================
   Text Edit
   ============================================ */

QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #ced4da;
    border-radius: 4px;
    color: #495057;
    selection-background-color: #007bff;
    selection-color: white;
    padding: 8px;
}

QTextEdit:hover, QPlainTextEdit:hover {
    border-color: #adb5bd;
}

QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #007bff;
}

QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: #f8f9fa;
    color: #adb5bd;
    border-color: #e9ecef;
}

/* ============================================
   Combo Box
   ============================================ */

QComboBox {
    background-color: #ffffff;
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 5px 36px 5px 10px;
    color: #495057;
    min-height: 24px;
}

QComboBox:hover {
    border-color: #adb5bd;
}

QComboBox:focus, QComboBox:on {
    border-color: #007bff;
}

QComboBox:disabled {
    background-color: #f8f9fa;
    color: #adb5bd;
    border-color: #e9ecef;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 36px;
    border-left: 1px solid #ced4da;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(:/icons/icon/arrow-down-icon.svg);
    width: 12px;
    height: 12px;
    margin: 6px;
}

QComboBox QAbstractItemView {
    padding: 4px;
    border: 1px solid #e9ecef;
    border-radius: 4px;
    color: #495057;
    background-color: #ffffff;
    selection-background-color: #e3f2fd;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 6px 12px;
    min-height: 28px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #e3f2fd;
    color: #495057;
}

/* ============================================
   Check Box
   ============================================ */

QCheckBox {
    color: #495057;
    spacing: 8px;
}

QCheckBox:disabled {
    color: #adb5bd;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:unchecked {
    background-color: #ffffff;
    border: 2px solid #ced4da;
    border-radius: 3px;
}

QCheckBox::indicator:unchecked:hover {
    border-color: #007bff;
}

QCheckBox::indicator:checked {
    background-color: #007bff;
    border: 2px solid #007bff;
    border-radius: 3px;
}

QCheckBox::indicator:checked:disabled {
    background-color: #6caedd;
    border-color: #6caedd;
}

QCheckBox::indicator:unchecked:disabled {
    background-color: #f8f9fa;
    border-color: #e9ecef;
}

/* ============================================
   Radio Button
   ============================================ */

QRadioButton {
    color: #495057;
    spacing: 8px;
}

QRadioButton:disabled {
    color: #adb5bd;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

QRadioButton::indicator:unchecked {
    background-color: #ffffff;
    border: 2px solid #ced4da;
    border-radius: 8px;
}

QRadioButton::indicator:unchecked:hover {
    border-color: #007bff;
}

QRadioButton::indicator:checked {
    background-color: #007bff;
    border: 2px solid #007bff;
    border-radius: 8px;
}

QRadioButton::indicator:checked:disabled {
    background-color: #6caedd;
    border-color: #6caedd;
}

QRadioButton::indicator:unchecked:disabled {
    background-color: #f8f9fa;
    border-color: #e9ecef;
}

/* ============================================
   Group Box
   ============================================ */

QGroupBox {
    font-weight: bold;
    color: #343a40;
    border: 1px solid #e9ecef;
    border-radius: 8px;
    margin-top: 8px;
    padding-top: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 8px 0 8px;
    background-color: #ffffff;
}

QGroupBox::indicator {
    width: 15px;
    height: 15px;
}

/* ============================================
   Tab Widget
   ============================================ */

QTabWidget::pane {
    background-color: #ffffff;
    border: 1px solid #e9ecef;
    border-radius: 4px;
    margin-top: -1px;
}

QTabBar::tab {
    background-color: #f8f9fa;
    border: 1px solid #e9ecef;
    padding: 4px 10px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    color: #6c757d;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #343a40;
    border-bottom-color: #ffffff;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background-color: #e9ecef;
    color: #495057;
}

/* ============================================
   Progress Bar
   ============================================ */

QProgressBar {
    background-color: #e9ecef;
    border: none;
    border-radius: 8px;
    text-align: center;
    color: #000000;
    font-weight: bold;
    height: 20px;
}

QProgressBar::chunk {
    background-color: #007bff;
    border-radius: 8px;
}

/* ============================================
   Slider
   ============================================ */

QSlider::groove:horizontal {
    background-color: #e9ecef;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #007bff;
    border: 2px solid #ffffff;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    margin: -8px 0;
}

QSlider::handle:horizontal:hover {
    background-color: #0056b3;
}

QSlider::groove:vertical {
    background-color: #e9ecef;
    width: 4px;
    border-radius: 2px;
}

QSlider::handle:vertical {
    background-color: #007bff;
    border: 2px solid #ffffff;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    margin: 0 -8px;
}

QSlider::handle:vertical:hover {
    background-color: #0056b3;
}

/* ============================================
   Menu Bar
   ============================================ */

QMenuBar {
    background-color: #f8f9fa;
    border-bottom: 1px solid #e9ecef;
    color: #495057;
    padding: 4px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #e9ecef;
}

QMenuBar::item:pressed {
    background-color: #007bff;
    color: white;
}

/* ============================================
   Menu
   ============================================ */

QMenu {
    background-color: #ffffff;
    border: 1px solid #e9ecef;
    border-radius: 6px;
    padding: 4px;
    color: #495057;
}

QMenu::item {
    padding: 6px 12px;
    border-radius: 4px;
    margin: 1px;
}

QMenu::item:selected {
    background-color: #e3f2fd;
    color: #495057;
}

QMenu::item:disabled {
    color: #adb5bd;
}

QMenu::separator {
    height: 1px;
    background-color: #e9ecef;
    margin: 4px 0px;
}

/* ============================================
   Status Bar
   ============================================ */

QStatusBar {
    background-color: #f8f9fa;
    border-top: 1px solid #e9ecef;
    color: #6c757d;
    font-size: 8pt;
}

/* ============================================
   Tool Bar & Tool Button
   ============================================ */

QToolBar {
    background-color: #f8f9fa;
    border: none;
    spacing: 2px;
    padding: 4px;
}

QToolBar::separator {
    background-color: #e9ecef;
    width: 1px;
    margin: 4px 2px;
}

QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 6px;
    color: #495057;
}

QToolButton:hover {
    background-color: #e9ecef;
}

QToolButton:pressed {
    background-color: #ced4da;
}

QToolButton:checked {
    background-color: #007bff;
    color: white;
}

/* ============================================
   Scroll Bars
   ============================================ */

QScrollBar:vertical {
    background-color: transparent;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #ced4da;
    border-radius: 6px;
    min-height: 20px;
    margin: 0px;
}

QScrollBar::handle:vertical:hover {
    background-color: #adb5bd;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #ced4da;
    border-radius: 6px;
    min-width: 20px;
    margin: 0px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #adb5bd;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* ============================================
   List Widget
   ============================================ */

QListWidget, QListView {
    background-color: #ffffff;
    border: 1px solid #e9ecef;
    border-radius: 4px;
    color: #495057;
    selection-background-color: #e3f2fd;
    outline: none;
}

QListWidget::item, QListView::item {
    padding: 8px;
    border-bottom: 1px solid #f8f9fa;
}

QListWidget::item:selected, QListView::item:selected {
    background-color: #e3f2fd;
    color: #495057;
}

QListWidget::item:hover, QListView::item:hover {
    background-color: #f8f9fa;
}

/* ============================================
   Tree Widget
   ============================================ */

QTreeWidget, QTreeView {
    background-color: #ffffff;
    border: 1px solid #e9ecef;
    border-radius: 4px;
    color: #495057;
    selection-background-color: #e3f2fd;
    outline: none;
}

QTreeWidget::item, QTreeView::item {
    padding: 2px 2px;
    border-bottom: 1px solid #f8f9fa;
    min-height: 22px;
}

QTreeWidget::item:selected, QTreeView::item:selected {
    background-color: #e3f2fd;
    color: #495057;
}

QTreeWidget::item:hover, QTreeView::item:hover {
    background-color: #f8f9fa;
}

/* ============================================
   Compact Widgets inside QTreeWidget
   (override of the global widget styles for items
   embedded via setItemWidget — keep rows narrow)
   Target: widget height ~24px to fit a 28px row hint
   with ~2px breathing room top/bottom.
   ============================================ */

/* Shared sizing/shape — text inputs and buttons.
   Widget content 18px → total 22px (with 1px padding + 1px border each side).
   The widget's own size hint helps Qt grow the row; the item's
   min-height (set on QTreeWidget::item) is a second guarantee. */
QTreeWidget QSpinBox,
QTreeWidget QDoubleSpinBox,
QTreeWidget QLineEdit,
QTreeWidget QPushButton {
    padding: 1px 8px;
    min-height: 18px;
    max-height: 18px;
}

/* ComboBox needs extra right padding for its drop-down */
QTreeWidget QComboBox {
    padding: 1px 22px 1px 8px;
    min-height: 18px;
    max-height: 18px;
}

QTreeWidget QComboBox::drop-down {
    width: 20px;
    border-left: none;
}

QTreeWidget QComboBox::down-arrow {
    width: 10px;
    height: 10px;
    margin: 4px;
}

/* CheckBox sits naturally — keep indicator centered, no border/padding override */
QTreeWidget QCheckBox {
    min-height: 18px;
    max-height: 22px;
    spacing: 6px;
}

/* Blue button look — only for QPushButton */
QTreeWidget QPushButton {
    background-color: #2563eb;
    color: white;
    min-width: 16px;
    border: none;
    border-radius: 4px;
}

QTreeWidget QPushButton:hover {
    background-color: #1d4ed8;
}

QTreeWidget QPushButton:pressed {
    background-color: #1e40af;
}

/* Compact restore button — keeps fixed size (20x20), padding overridden */
QTreeWidget QPushButton#RestoreButton {
    padding: 2px;
    min-width: 16px;
    min-height: 16px;
    font-size: 12px;
}

/* ============================================
   Table Widget
   ============================================ */

QTableWidget, QTableView {
    background-color: #ffffff;
    border: 1px solid #e9ecef;
    border-radius: 4px;
    gridline-color: #f8f9fa;
    selection-background-color: #e3f2fd;
    outline: none;
}

QTableWidget::item, QTableView::item {
    padding: 8px;
    color: #495057;
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color: #e3f2fd;
    color: #495057;
}

QHeaderView::section {
    background-color: #f8f9fa;
    border: none;
    border-right: 1px solid #e9ecef;
    border-bottom: 1px solid #e9ecef;
    padding: 8px;
    font-weight: bold;
    color: #343a40;
}

/* ============================================
   Splitter
   ============================================ */

QSplitter::handle {
    background-color: #e9ecef;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

/* ============================================
   Tooltip
   ============================================ */

QToolTip {
    background-color: #343a40;
    color: #ffffff;
    border: 1px solid #495057;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 8pt;
}
